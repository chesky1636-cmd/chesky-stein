# Copy to .env for local development only. On Railway set these as service Variables.
DATABASE_URL=postgres://postgres@localhost:5432/school
# DATABASE_SSL=true            # only if your Postgres requires SSL from outside Railway's private network
NODE_ENV=development

# Initial PINs (4-12 digits). They are hashed into the database on first start and can then be
# changed by the super administrator in the admin panel. RESET_PINS=true re-seeds them (recovery).
ADMIN_PIN=
SUPER_ADMIN_PIN=

# Telegram (optional). Keep the token secret: set it only as a Railway variable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SOURCE_CHAT_IDS=      # comma separated chat ids the bot may import from (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=           # channel id for outgoing announcements
TELEGRAM_WEBHOOK_SECRET=       # optional; derived from the token if empty
# TELEGRAM_MODE=webhook        # webhook | polling | off (default: webhook when a public URL is known)
# PUBLIC_URL=https://example.up.railway.app   # Railway sets RAILWAY_PUBLIC_DOMAIN automatically

# Location used for sunset (Jewish date changes at sunset)
SCHOOL_LATITUDE=40.6782
SCHOOL_LONGITUDE=-73.9442
SCHOOL_TZ=America/New_York
