<%- include('_top') %>
<div class="block-head"><h1>בחורים</h1><a class="more btn gold sm" href="/admin/boys/new">+ נייער בחור</a></div>
<form class="card" method="get" action="/admin/boys">
  <div class="row">
    <div class="field"><label for="b-q">זוכן (אויך אנדערע אויסלייגן)</label><input id="b-q" type="search" name="q" value="<%= q %>"></div>
    <div class="field"><label for="b-b">סניף</label><select id="b-b" name="branch"><option value="">אלע</option><% branches.forEach(function (b) { %><option value="<%= b.id %>" <%= branchF === b.id ? 'selected' : '' %>><%= b.name %></option><% }) %></select></div>
  </div>
  <button class="btn sm" type="submit">זוכן</button>
</form>
<div class="table-wrap block"><table class="list">
  <thead><tr><th>נאמען</th><th>אנדערע נעמען</th><th>סניף</th><th>רעקארדס</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(function (b) { %>
    <tr><td><a href="/admin/boys/<%= b.id %>"><%= b.official_name %></a></td><td class="small"><%= b.alias_list || '' %></td><td><%= branches.find(function (x) { return x.id === b.branch; }).name %></td><td><%= b.occasion_count %></td><td><a class="btn ghost sm" href="/boy/<%= b.id %>">פראפיל</a></td></tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="5" class="muted">קיין בחורים.</td></tr><% } %>
  </tbody>
</table></div>
<nav class="pager"><% if (page > 1) { %><a class="btn ghost sm" href="?q=<%= encodeURIComponent(q) %>&branch=<%= branchF %>&page=<%= page - 1 %>">‹ פריער</a><% } %><% if (rows.length === 60) { %><a class="btn ghost sm" href="?q=<%= encodeURIComponent(q) %>&branch=<%= branchF %>&page=<%= page + 1 %>">ווייטער ›</a><% } %></nav>
<%- include('_bottom') %>
